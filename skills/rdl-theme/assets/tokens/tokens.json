    "sm": 8,
    "md": 12,
    "tile": 14,
    "base": 16,
    "lg": 20,
    "panel": 24,
    "xl": 28,
    "2xl": 32,
    "3xl": 40,
    "sheet": 48,
    "pill": 999
  },
