{
  "meta": {
    "name": "RDL Theme",
    "version": "1.0.0",
    "description": "Design tokens distilled from the RonDesignLab (RDL) Dribbble portfolio. Source of truth — run scripts/build_tokens.mjs to regenerate CSS, Tailwind and SwiftUI outputs.",
    "calibration": "v1 values are derived from the RDL shot inventory and the studio's recurring visual language, not pixel-sampled. Run scripts/extract_palette.py on real shots to calibrate."
  },

  "primitive": {
    "ink":    { "950": "#0B0B0D", "900": "#141417", "800": "#1C1C20", "700": "#26262B", "600": "#34343A" },
    "gray":   { "0": "#FFFFFF", "50": "#F8F8FA", "100": "#F3F3F5", "150": "#EBEBEF", "200": "#E2E2E7", "300": "#C8C8CF", "400": "#9A9AA3", "500": "#6E6E78", "600": "#55555E" },
    "lime":   { "50": "#F7FDE3", "100": "#EEFBC4", "200": "#E3F89A", "300": "#D8F56F", "400": "#CBEF43", "500": "#B2D92A", "600": "#8CAF12", "700": "#5F7A08" },
    "violet": { "50": "#F4F1FF", "100": "#E9E3FF", "200": "#D2C6FF", "300": "#B09CFF", "400": "#9076FF", "500": "#7152F5", "600": "#5A3BDB", "700": "#4329AE" },
    "orange": { "50": "#FFF3EE", "100": "#FFE3D7", "200": "#FFC3AA", "300": "#FF9D75", "400": "#FF7A45", "500": "#F55F24", "600": "#D24812", "700": "#A1360B" },
    "blue":   { "50": "#EEF4FF", "100": "#DCE7FF", "200": "#B6CCFF", "300": "#84A9FF", "400": "#5585FF", "500": "#2F66F6", "600": "#1F4FD1", "700": "#173B9E" },
    "gold":   { "50": "#FDF8EA", "100": "#FAEDC7", "200": "#F4DA8E", "300": "#EBC45C", "400": "#DDAE3A", "500": "#C39222", "600": "#9C7215", "700": "#6E500E" },
    "mint":   { "50": "#EAFBF3", "100": "#CFF5E3", "300": "#7CE0B3", "500": "#1FB877", "600": "#13965F", "700": "#0E7048" },
    "red":    { "50": "#FFF0F0", "100": "#FFDCDC", "300": "#FF9A9A", "500": "#F0453E", "600": "#CC2F29" },
    "amber":  { "50": "#FFF8E6", "100": "#FFEDBF", "300": "#FFD266", "500": "#F5A70B", "600": "#CC8700", "700": "#8A5B00" }
  },

  "semantic": {
    "light": {
      "bg-canvas":            "{gray.100}",
      "bg-surface":           "{gray.0}",
      "bg-surface-muted":     "{gray.100}",
      "bg-hero":              "{ink.950}",
      "bg-hero-raised":       "{ink.700}",
      "fill-control":         "{gray.100}",
      "fill-control-hover":   "{gray.150}",
      "fill-control-strong":  "{ink.950}",
      "text-primary":         "{ink.950}",
      "text-secondary":       "{gray.500}",
      "text-tertiary":        "{gray.400}",
      "text-on-hero":         "{gray.0}",
      "text-on-hero-muted":   "#A3A3AD",
      "text-on-strong":       "{gray.0}",
      "border-subtle":        "{gray.200}",
      "border-strong":        "{gray.300}",
      "chart-track":          "{gray.150}",
      "chart-muted":          "{gray.200}",
      "chart-hatch":          "{gray.300}",
      "success":              "{mint.500}",
      "success-soft":         "{mint.50}",
      "success-text":         "{mint.700}",
      "danger":               "{red.500}",
      "danger-soft":          "{red.50}",
      "danger-text":          "{red.600}",
      "warning":              "{amber.500}",
      "warning-soft":         "{amber.50}",
      "warning-text":         "{amber.700}",
      "info":                 "{blue.500}",
      "info-soft":            "{blue.50}",
      "scrim":                "rgba(11,11,13,0.48)"
    },
    "dark": {
      "bg-canvas":            "{ink.950}",
      "bg-surface":           "#17171A",
      "bg-surface-muted":     "#202024",
      "bg-hero":              "#232327",
      "bg-hero-raised":       "{ink.600}",
      "fill-control":         "#232327",
      "fill-control-hover":   "#2C2C31",
      "fill-control-strong":  "{gray.0}",
      "text-primary":         "#F5F5F7",
      "text-secondary":       "#A3A3AD",
      "text-tertiary":        "#6E6E78",
      "text-on-hero":         "{gray.0}",
      "text-on-hero-muted":   "#A3A3AD",
      "text-on-strong":       "{ink.950}",
      "border-subtle":        "#26262B",
      "border-strong":        "#34343A",
      "chart-track":          "#232327",
      "chart-muted":          "#2C2C31",
      "chart-hatch":          "#44444B",
      "success":              "{mint.300}",
      "success-soft":         "rgba(31,184,119,0.14)",
      "success-text":         "{mint.300}",
      "danger":               "{red.300}",
      "danger-soft":          "rgba(240,69,62,0.14)",
      "danger-text":          "{red.300}",
      "warning":              "{amber.300}",
      "warning-soft":         "rgba(245,167,11,0.14)",
      "warning-text":         "{amber.300}",
      "info":                 "{blue.300}",
      "info-soft":            "rgba(47,102,246,0.16)",
      "scrim":                "rgba(0,0,0,0.64)"
    }
  },

  "accents": {
    "lime":   { "accent": "{lime.400}",   "accent-strong": "{lime.500}",   "accent-soft": "{lime.100}",   "on-accent": "{ink.950}", "accent-text": "{lime.700}",   "accent-text-dark": "{lime.300}" },
    "violet": { "accent": "{violet.500}", "accent-strong": "{violet.600}", "accent-soft": "{violet.50}",  "on-accent": "{gray.0}",  "accent-text": "{violet.600}", "accent-text-dark": "{violet.300}" },
    "orange": { "accent": "{orange.500}", "accent-strong": "{orange.600}", "accent-soft": "{orange.50}",  "on-accent": "{ink.950}",  "accent-text": "{orange.600}", "accent-text-dark": "{orange.300}" },
    "ocean":  { "accent": "{blue.500}",   "accent-strong": "{blue.600}",   "accent-soft": "{blue.50}",    "on-accent": "{gray.0}",  "accent-text": "{blue.600}",   "accent-text-dark": "{blue.300}" },
    "gold":   { "accent": "{gold.400}",   "accent-strong": "{gold.500}",   "accent-soft": "{gold.50}",    "on-accent": "{ink.950}", "accent-text": "{gold.700}",   "accent-text-dark": "{gold.300}" }
  },

  "type": {
    "family": {
      "sans": "\"Inter\", \"SF Pro Display\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "sans-alt": "\"Manrope\", \"Inter\", -apple-system, sans-serif",
      "mono": "\"JetBrains Mono\", \"SF Mono\", ui-monospace, monospace"
    },
    "scale": {
      "display-xl": { "size": 56, "line": 60, "weight": 500, "tracking": -0.035 },
      "display":    { "size": 44, "line": 48, "weight": 500, "tracking": -0.03 },
      "h1":         { "size": 32, "line": 38, "weight": 600, "tracking": -0.025 },
      "h2":         { "size": 26, "line": 32, "weight": 600, "tracking": -0.02 },
      "h3":         { "size": 20, "line": 26, "weight": 600, "tracking": -0.015 },
      "title":      { "size": 17, "line": 22, "weight": 600, "tracking": -0.01 },
      "body":       { "size": 15, "line": 22, "weight": 400, "tracking": -0.005 },
      "body-strong":{ "size": 15, "line": 22, "weight": 500, "tracking": -0.005 },
      "label":      { "size": 14, "line": 18, "weight": 500, "tracking": -0.005 },
      "caption":    { "size": 12, "line": 16, "weight": 500, "tracking": 0 },
      "micro":      { "size": 11, "line": 14, "weight": 500, "tracking": 0.01 }
    }
  },

  "space": { "0": 0, "0.5": 2, "1": 4, "1.5": 6, "2": 8, "2.5": 10, "3": 12, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "10": 40, "12": 48, "14": 56, "16": 64, "20": 80 },

  "layout": {
    "mobile-gutter": 20,
    "card-padding": 20,
    "card-gap": 12,
    "section-gap": 28,
    "web-sidebar": 248,
    "web-gutter": 32,
    "web-grid-gap": 16
  },

  "radius": { "xs": 6, "sm": 10, "md": 14, "lg": 20, "xl": 24, "2xl": 28, "3xl": 32, "pill": 999 },

  "size": {
    "control-sm": 36,
    "control-md": 44,
    "control-lg": 56,
    "icon-button": 44,
    "tab-bar": 64,
    "avatar-sm": 32,
    "avatar-md": 40,
    "avatar-lg": 56,
    "icon-sm": 16,
    "icon-md": 20,
    "icon-lg": 24
  },

  "shadow": {
    "none":  "none",
    "sm":    "0 1px 2px rgba(16,16,20,0.04), 0 2px 8px rgba(16,16,20,0.04)",
    "md":    "0 4px 12px rgba(16,16,20,0.05), 0 12px 32px rgba(16,16,20,0.06)",
    "lg":    "0 12px 24px rgba(16,16,20,0.08), 0 24px 56px rgba(16,16,20,0.10)",
    "float": "0 16px 40px rgba(11,11,13,0.24)"
  },

  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320, "chart": 600 },
    "easing": {
      "standard":   "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1.15)",
      "exit":       "cubic-bezier(0.4, 0, 1, 1)"
    },
    "spring": { "response": 0.35, "damping": 0.82 },
    "stagger": 40
  }
}
